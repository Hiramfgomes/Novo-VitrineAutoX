      "type": "object",
      "properties": {
        "menu_veiculos": { "type": "string" },
        "menu_servicos": { "type": "string" },
        "menu_eventos": { "type": "string" },
        "menu_noticias": { "type": "string" },
        "ajuda_suporte": { "type": "string" },
        "contato": { "type": "string" },
        "privacidade": { "type": "string" },
        "termo_uso": { "type": "string" },
        "sobre_nos": { "type": "string" },
        "para_lojista": { "type": "string" },
        "para_anunciantes": { "type": "string" },
        "lgpd": { "type": "string" },
        "siga_nos": {
          "type": "object",
          "properties": {
            "instagram": { "type": "string" },
            "facebook": { "type": "string" },
            "youtube": { "type": "string" },
            "whatsapp": { "type": "string" }
          }
        },
        "updatedAt": { "type": "string", "format": "date-time" }
      }
    },
    "Alert": {
      "title": "Alert",
      "description": "User search criteria for new vehicle notifications.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "manufacturer": { "type": "string" },
        "model": { "type": "string" },
        "minPrice": { "type": "number" },
        "maxPrice": { "type": "number" },
        "minYear": { "type": "integer" },
        "maxYear": { "type": "integer" },

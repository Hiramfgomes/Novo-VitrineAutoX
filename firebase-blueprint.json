        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["listingId", "ownerId", "views"]
    },
    "Event": {
      "title": "Event",
      "description": "Automotive events details managed by admin.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "startDate": { "type": "string" },
        "endDate": { "type": "string" },
        "startTime": { "type": "string" },
        "endTime": { "type": "string" },
        "category": { "type": "string" },
        "organizer": { "type": "string" },
        "phone": { "type": "string" },
        "location": { "type": "string" },
        "state": { "type": "string" },
        "city": { "type": "string" },
        "fullAddress": { "type": "string" },
        "attendees": { "type": "integer" },
        "image": { "type": "string" },
        "images": { "type": "array", "items": { "type": "string" } },
        "link": { "type": "string" },
        "socialLinks": {
          "type": "object",
          "properties": {
            "instagram": { "type": "string" },
            "facebook": { "type": "string" },
            "youtube": { "type": "string" }
          }

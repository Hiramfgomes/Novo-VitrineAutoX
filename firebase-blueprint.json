        "createdAt": { "type": "string", "format": "date-time" },
        "active": { "type": "boolean" }
      },
      "required": ["id", "userId", "createdAt", "active"]
    },
    "Notification": {
      "title": "Notification",
      "description": "In-app and push notification history.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "message": { "type": "string" },
        "type": { "type": "string", "enum": ["system", "alert", "promotion"] },
        "read": { "type": "boolean" },
        "link": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userId", "title", "message", "type", "read", "createdAt"]
    },
    "PushToken": {
      "title": "PushToken",
      "description": "FCM tokens for push notifications.",
      "type": "object",
      "properties": {
        "token": { "type": "string" },
        "userId": { "type": "string" },
        "platform": { "type": "string" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["token", "userId", "updatedAt"]
    },
    "Lead": {
      "title": "Lead",
      "description": "Information about a potential customer inquiry.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "listingId": { "type": "string" },
        "listingType": { "type": "string", "enum": ["vehicle", "product", "service"] },
        "listingTitle": { "type": "string" },
        "customerName": { "type": "string" },
        "customerEmail": { "type": "string" },
        "customerPhone": { "type": "string" },
        "customerId": { "type": "string", "description": "The UID of the customer (buyer)." },
        "ownerId": { "type": "string", "description": "The UID of the listing owner (seller)." },
        "participants": { "type": "array", "items": { "type": "string" }, "description": "Array containing [customerId, ownerId] for easier querying." },
        "status": { "type": "string", "enum": ["new", "viewed", "contacted", "closed"] },
        "lastMessage": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "listingId", "customerName", "ownerId", "status"]
    },
    "LeadMessage": {
      "title": "LeadMessage",
      "description": "A message within a lead conversation.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "leadId": { "type": "string" },
        "senderId": { "type": "string" },
        "message": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "leadId", "senderId", "message", "createdAt"]
    },

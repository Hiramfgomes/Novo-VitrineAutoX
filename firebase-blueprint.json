        "contactName": { "type": "string" },
        "whatsapp": { "type": "string" },
        "city": { "type": "string" },
        "state": { "type": "string" },
        "neighborhood": { "type": "string" }
      },
      "required": ["id", "name", "price", "ownerId", "status", "paymentStatus"]
    },
    "Service": {
      "title": "Service",
      "description": "Automotive service details.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "price": { "type": "number" },
        "category": { 
          "type": "string",
          "enum": ["financeiras", "oficina", "estetica_lavajato", "inspecao", "seguros"]
        },
        "images": { "type": "array", "items": { "type": "string" } },
        "ownerId": { "type": "string" },
        "status": { "type": "string", "enum": ["active", "inactive", "pending"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "paymentStatus": { "type": "string", "enum": ["unpaid", "paid", "pending"] },
        "paymentId": { "type": "string" },
        "plan": { "type": "string", "enum": ["basic", "premium"] },
        "contactName": { "type": "string" },
        "whatsapp": { "type": "string" },
        "city": { "type": "string" },
        "state": { "type": "string" },
        "neighborhood": { "type": "string" }
      },
      "required": ["id", "name", "ownerId", "status", "paymentStatus"]
    },
    "AppSetting": {
      "title": "AppSetting",

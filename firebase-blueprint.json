{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile information and role.",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string" },
        "role": { "type": "string", "enum": ["user", "admin", "lojista"] },
        "phoneNumber": { "type": "string" },
        "companyName": { "type": "string" },
        "cnpj": { "type": "string" },
        "address": { "type": "string" },
        "city": { "type": "string" },
        "state": { "type": "string" },
        "phone": { "type": "string" },
        "whatsapp": { "type": "string" },
        "instagram": { "type": "string" },
        "facebook": { "type": "string" },
        "tiktok": { "type": "string" },
        "logo": { "type": "string" },
        "bio": { "type": "string" },
        "service_documentacao": { "type": "boolean" },
        "service_garantia": { "type": "boolean" },
        "service_higienizacao": { "type": "boolean" },
        "service_suporte": { "type": "boolean" },
        "service_entrega": { "type": "boolean" },
        "service_precedencia": { "type": "boolean" },
        "service_laudo_cautelar": { "type": "boolean" },
        "service_financiamentos": { "type": "boolean" },
        "service_seguros": { "type": "boolean" },
        "service_revisao_pre_entrega": { "type": "boolean" },
        "city": { "type": "string" },
        "state": { "type": "string" },
        "isFeatured": { "type": "boolean", "description": "Whether the lojista is featured (paid highlight)." },
        "subscription": {
          "type": "object",
          "properties": {
            "status": { "type": "string", "enum": ["active", "inactive", "expired"] },
            "plan": { "type": "string", "enum": ["semestral", "anual"] },
            "expiresAt": { "type": "string", "format": "date-time" },
            "paymentId": { "type": "string" }
          }
        },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "role"]
    },
    "Vehicle": {
      "title": "Vehicle",
      "description": "Automobile details.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "manufacturer": { "type": "string" },
        "model": { "type": "string" },
        "version": { "type": "string" },

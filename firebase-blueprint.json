        "modelYear": { "type": "integer", "description": "Ano do modelo" },
        "price": { "type": "number" },
        "vehicleValue": { "type": "number" },
        "resalePrice": { "type": "number" },
        "mileage": { "type": "number" },
        "engine": { "type": "string" },
        "fuelType": { "type": "string" },
        "transmission": { "type": "string" },
        "color": { "type": "string" },
        "description": { "type": "string" },
        "images": { "type": "array", "items": { "type": "string" } },
        "ownerId": { "type": "string" },
        "status": { "type": "string", "enum": ["active", "sold", "pending"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "category": { "type": "string", "enum": ["car", "motorcycle", "truck", "heavy", "nautical", "other"] },
        "isFeatured": { "type": "boolean", "description": "Whether the vehicle is featured (paid highlight)." },
        "paymentStatus": { "type": "string", "enum": ["unpaid", "paid", "pending"] },
        "paymentId": { "type": "string" },
        "plan": { "type": "string", "enum": ["basic", "premium", "featured"] },
        "contactName": { "type": "string" },
        "whatsapp": { "type": "string" },
        "city": { "type": "string" },
        "state": { "type": "string" },
        "neighborhood": { "type": "string" }
      },
      "required": ["id", "manufacturer", "model", "price", "ownerId", "status", "paymentStatus"]
    },
    "Product": {
      "title": "Product",

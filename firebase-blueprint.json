  "firestore": {
    "/users/{uid}": {
      "schema": "UserProfile",
      "description": "User profiles."
    },
    "/admins/{fbUid}": {
      "schema": "AdminSession",
      "description": "Admin session mapping."
    },
    "/users/{uid}/alerts/{alertId}": {
      "schema": "Alert",
      "description": "User's search alerts."
    },
    "/users/{uid}/notifications/{notificationId}": {
      "schema": "Notification",
      "description": "User's notifications."
    },
    "/push_tokens/{tokenId}": {
      "schema": "PushToken",
      "description": "FCM push tokens."
    },
    "/vehicles/{vehicleId}": {
      "schema": "Vehicle",
      "description": "Vehicle listings."
    },
    "/products/{productId}": {
      "schema": "Product",
      "description": "Product listings."
    },
    "/services/{serviceId}": {
      "schema": "Service",
      "description": "Service listings."
    },
    "/settings/app_control": {
      "schema": "AppControl",
      "description": "Core application customization configurations."
    },
    "/settings/{settingId}": {
      "schema": "AppSetting",
      "description": "Global application settings like floating banner."
    },
    "/leads/{leadId}": {
      "schema": "Lead",
      "description": "Customer leads."
    },
    "/leads/{leadId}/messages/{messageId}": {
      "schema": "LeadMessage",
      "description": "Messages for a lead."
    },
    "/listing_stats/{listingId}": {
      "schema": "ListingStats",
      "description": "Statistics for a listing."
    },
    "/events/{eventId}": {
      "schema": "Event",
      "description": "Automotive events."
    },
    "/event_reviews/{reviewId}": {
      "schema": "EventReview",
      "description": "User ratings and comments for events."
    },
    "/test_drives/{testDriveId}": {
      "schema": "TestDrive",
      "description": "Test drive appointments."
    },
    "/video_calls/{videoCallId}": {
      "schema": "VideoCall",
      "description": "Video call show-room appointments."
    },
    "/dealer_stories/{storyId}": {
      "schema": "DealerStory",
      "description": "Dealer visual marketing stories."
    },
    "/contracts/{contractId}": {
      "schema": "Contract",
      "description": "Generated contracts."
    },
    "/evaluations/{evaluationId}": {
      "schema": "VehicleEvaluation",
      "description": "Vehicle evaluations and pricing results."
    }
  }
}
